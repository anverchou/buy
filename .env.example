# Copy to .env and fill in what you need. Every setting is optional:
# with no API keys the app runs on seeded demo data.

# --- Data sources -----------------------------------------------------------
# auto = live adapters when any key below is set, demo data otherwise
# mock = always demo data;  live = real sources only (search fails without a key)
DATA_MODE=auto

# SerpApi (Google Shopping): current prices across retailers. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Hard stop so the app never exceeds your plan (free plan = 250 searches/month).
SERPAPI_MONTHLY_LIMIT=250

# Keepa: Amazon price history (paid API, no free tier). https://keepa.com/#!api
KEEPA_API_KEY=
# 1 = amazon.com. Other marketplaces: 2 UK, 3 DE, 4 FR, 5 JP, 6 CA, 8 IT, 9 ES, 10 IN, 11 MX
KEEPA_DOMAIN=1

# --- App ----------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Days and "last checked" times use this zone (IANA name).
APP_TIMEZONE=America/Los_Angeles
# Set a password if the app is reachable from other devices (phone over Wi-Fi, a server).
APP_PASSWORD=
# Default is a SQLite file in ./instance. Any SQLAlchemy URL works, e.g. postgresql+psycopg://...
DATABASE_URL=
# A price older than this many days is shown as stale and not counted as "lowest".
STALE_AFTER_DAYS=7

# --- Demo data ----------------------------------------------------------------
# Load the demo shopping list automatically on first start (demo mode only).
AUTO_SEED_DEMO=true
# Change to get a different (still deterministic) set of simulated prices.
MOCK_SEED=42

# --- Price-drop push alerts (optional) -----------------------------------------
# Install the ntfy app, subscribe to a hard-to-guess topic name, and put it here.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Used to make the notification open the product page, e.g. http://192.168.1.20:5000
APP_BASE_URL=
