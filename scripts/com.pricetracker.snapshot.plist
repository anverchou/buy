<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd job: runs the snapshot every hour (idempotent; one API pass per day).
     Replace /Users/YOU/price-tracked-shopping-list with the real path, then:
       cp scripts/com.pricetracker.snapshot.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.pricetracker.snapshot.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pricetracker.snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOU/price-tracked-shopping-list/scripts/run_snapshot.sh</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
